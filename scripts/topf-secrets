#!/usr/bin/env bash
# topf secrets provider: keeps the Talos secrets bundle in 1Password.
set -euo pipefail

vault=bitshift-prod
title="talos-secrets-${3:?usage: secrets-provider secrets <get|put> <cluster>}"

# Empty output tells topf to generate a bundle, so an op failure must abort
# rather than look like a missing item.
items="$(op item list --vault "$vault" --categories Document --format json)"

exists() {
    jq -e --arg t "$title" 'any(.[]; .title == $t)' <<<"$items" >/dev/null
}

case "$2" in
    get)
        if exists; then
            op document get "$title" --vault "$vault"
        fi
        ;;
    put)
        if exists; then
            echo "refusing to overwrite existing $title" >&2
            exit 1
        fi
        op document create - --vault "$vault" --title "$title" --file-name secrets.yaml >/dev/null
        ;;
    *)
        echo "unknown subcommand: $2" >&2
        exit 1
        ;;
esac
